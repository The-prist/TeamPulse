{
  "uid": "teampulse-overview",
  "title": "TeamPulse 概览",
  "tags": ["teampulse", "backend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求速率（按路由）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(teampulse_api_requests_total{application=\"teampulse\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "错误率（4xx/5xx）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri, status) (rate(teampulse_api_failures_total{application=\"teampulse\"}[5m]))",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "接口延迟 P50 / P95 / P99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(teampulse_api_latency_seconds_bucket{application=\"teampulse\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(teampulse_api_latency_seconds_bucket{application=\"teampulse\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(teampulse_api_latency_seconds_bucket{application=\"teampulse\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "打卡上报（成功 / 失败）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(teampulse_attendance_punch_total{result=\"success\"}[1h]))",
          "legendFormat": "成功"
        },
        {
          "refId": "B",
          "expr": "sum(increase(teampulse_attendance_punch_total{result=\"failure\"}[1h]))",
          "legendFormat": "失败"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "幂等命中（近 1h）",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(teampulse_attendance_idempotent_total[1h]))",
          "legendFormat": "{{layer}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "业务错误码分布",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (increase(teampulse_api_errors_total{application=\"teampulse\"}[1h]))",
          "legendFormat": "code {{code}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM 堆内存",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (area) (jvm_memory_used_bytes{application=\"teampulse\", area=\"heap\"})",
          "legendFormat": "heap"
        },
        {
          "refId": "B",
          "expr": "sum by (id) (jvm_memory_max_bytes{application=\"teampulse\", area=\"heap\", id=~\".*Old Gen.*\"})",
          "legendFormat": "max (old gen)"
        }
      ]
    }
  ]
}
