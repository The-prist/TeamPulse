<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：
    1) 控制台与文件使用同一格式，都带 traceId，便于把「一次请求的 5 行日志」串起来；
    2) 文件按大小与天数滚动，总量封顶，避免长期运行把磁盘写满；
    3) 业务包单独可调级别（默认 INFO，排查时可临时改 DEBUG）。
  落盘路径可用环境变量 LOG_PATH 覆盖，默认 ./logs/teampulse.log。
-->
<configuration>
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-no-trace}] %thread %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/teampulse.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/teampulse.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 监控端点每个抓取周期都会打日志，压到 WARN 免得刷屏 -->
    <logger name="org.springframework.boot.actuate" level="WARN"/>
    <logger name="com.teampulse" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
