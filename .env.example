# =====================================================================
# 复制为 .env 后修改。切勿把 .env 提交到 Git（已在 .gitignore 中忽略）
# 生成强随机值：openssl rand -hex 32
# =====================================================================

# ---- 数据库 ----
DB_NAME=teampulse
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_pwd

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_redis_pwd

# ---- MQTT 账号（ESP32 固件里要填同样的值）----
MQTT_USERNAME=teampulse
MQTT_PASSWORD=CHANGE_ME_mqtt_pwd

# ---- JWT 签名密钥：必须 >= 32 字节，否则应用启动即失败（有意为之）----
JWT_SECRET=CHANGE_ME_please_use_openssl_rand_hex_32_to_generate_a_long_secret

# ---- 初始管理员（仅首次启动、且用户表为空时生效）----
TPP_BOOTSTRAP_ENABLED=true
TPP_ADMIN_PASSWORD=CHANGE_ME_admin_pwd

# ---- 接口文档：生产建议关闭，需要演示时临时开启 ----
TPP_OPENAPI_ENABLED=false

# ---- 跨域：同源部署留空即可；若前端独立域名再填 https://your-domain.com ----
TPP_CORS_ORIGINS=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_pwd
