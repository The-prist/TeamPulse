/**
 * =============================================================================
 *  secrets.h.example —— 现场密钥模板
 * =============================================================================
 *
 *  怎么用（30 秒）
 *  ---------------------------------------------------------------------------
 *  1. 把本文件复制为同目录下的 secrets.h：
 *         copy secrets.h.example secrets.h
 *  2. 打开 secrets.h，把占位值换成真实值
 *  3. 直接编译上传 —— attendance_node.ino 会自动 include 它
 *
 *  为什么这么做
 *  ---------------------------------------------------------------------------
 *  attendance_node.ino 是提交到公开仓库的。如果真实 WiFi 密码 / 设备密钥
 *  直接写在 .ino 里，一次 git add 就永久留在提交历史里，事后删文件也删不掉，
 *  只能换密钥。
 *
 *  所以机制是：.ino 里用 #if __has_include("secrets.h") 判断——
 *    · 有 secrets.h（你本机）→ 用你的真实值
 *    · 没有（别人 clone 仓库）→ 用 .ino 里的占位值，仍能编译
 *  而 secrets.h 已在 .gitignore 中，永远进不了仓库。
 *
 *  设备密钥从哪来
 *  ---------------------------------------------------------------------------
 *  后端首次启动时 BootstrapDataInitializer 会为演示设备生成随机密钥，打印在
 *  日志里（形如 `设备密钥: xxxx...`），iot_device 表的 secret 字段也是同一份。
 *  把它填到 DEVICE_SECRET，固件与后端的 HMAC 签名校验才能通过，
 *  否则服务端一律返回 60003 验签失败。
 * =============================================================================
 */

#ifndef TP_SECRETS_H
#define TP_SECRETS_H

// ---- WiFi（ESP32 只支持 2.4GHz，5GHz 连不上）----
#define WIFI_SSID              "这里填你的 WiFi 名称"
#define WIFI_PASSWORD          "这里填你的 WiFi 密码"

// ---- 设备身份（必须与后端 iot_device 表一致）----
#define DEVICE_SN              "TP-ESP32-DEMO"
#define DEVICE_SECRET          "这里填后端日志里打印的 64 位十六进制密钥"

// ---- MQTT 账号（mosquitto 开了密码认证才需要，否则留空）----
#define MQTT_USERNAME          ""
#define MQTT_PASSWORD          ""

#endif  // TP_SECRETS_H
