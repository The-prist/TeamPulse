/**
 * =============================================================================
 *  secrets.h.example —— 现场密钥模板（把本文件复制为 secrets.h 后填写）
 * =============================================================================
 *
 *  为什么要有这个文件
 *  ---------------------------------------------------------------------------
 *  attendance_node.ino 里现有的 #define 全是占位值（YOUR_WIFI_SSID、空密码、
 *  示例 DEVICE_SECRET），直接提交没有泄露风险。但只要有人在源码里把真实
 *  WiFi 密码 / MQTT 密码 / 设备密钥填进去再 git add，密钥就永久留在提交
 *  历史里了——事后删文件也删不掉，只能换密钥。
 *
 *  所以推荐做法是：真实值只放在 secrets.h，而这个文件已被 .gitignore 忽略。
 *
 *  用法（三选一）
 *  ---------------------------------------------------------------------------
 *  1) 复制本文件为同目录下的 secrets.h，填好真实值，然后把
 *     attendance_node.ino 里「一、可配置项」那 6 行 #define 换成：
 *
 *         #include "secrets.h"
 *
 *     （注意：换成 include 后，别再在 .ino 里重复定义同名宏）
 *
 *  2) 不改源码，直接用编译宏注入（在 arduino-cli 或用 -D 参数时）：
 *
 *         --build-property "compiler.cpp.extra_flags=-DWIFI_SSID=\"my-ssid\""
 *
 *  3) 答辩/演示用一次性板子：保持占位值，现场手改，改完别提交。
 *
 *  设备密钥从哪来
 *  ---------------------------------------------------------------------------
 *  后端首次启动时，BootstrapDataInitializer 会为演示设备生成随机密钥并打印在
 *  日志里（也在 iot_device 表的 secret 字段）。把它填到 DEVICE_SECRET，
 *  固件与后端的 HMAC 签名校验才能通过（否则服务端回 60003 验签失败）。
 * =============================================================================
 */

#ifndef TP_SECRETS_H
#define TP_SECRETS_H

// ---- WiFi（ESP32 只支持 2.4GHz）----
#define WIFI_SSID              "YOUR_WIFI_SSID"
#define WIFI_PASSWORD          "YOUR_WIFI_PASSWORD"

// ---- 设备身份（必须与后端 iot_device 表一致）----
// 64 位十六进制，由后端生成；不要用示例值，否则验签必然失败
#define DEVICE_SN              "TP-ESP32-DEMO"
#define DEVICE_SECRET          "把这里换成后端日志里打印的 64 位十六进制密钥"

// ---- MQTT 账号（mosquitto 开了密码认证才需要）----
#define MQTT_USERNAME          ""
#define MQTT_PASSWORD          ""

#endif  // TP_SECRETS_H
